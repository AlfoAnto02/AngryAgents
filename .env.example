# ============================================================
# Angry Agents — environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to the repository.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Path to the SQLite database file (relative or absolute).
# Defaults to angry_agents.db in the working directory.
ANGRY_DB_PATH=angry_agents.db

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Secret used to compute the HMAC author digest on chat messages.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ANGRY_AUTHOR_SECRET=change-me-author-secret

# Secret used to sign JWT access and refresh tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-jwt-secret

# Access token lifetime in minutes (default: 15).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7).
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to a positive integer to override REFRESH_TOKEN_EXPIRE_DAYS with minutes
# (useful in development). 0 means "use days instead".
REFRESH_TOKEN_EXPIRE_MINUTES=0

# Set to 1 in production (HTTPS only). Keep 0 for local HTTP development.
COOKIE_SECURE=0

# ------------------------------------------------------------
# Auth (development only)
# ------------------------------------------------------------

# Set to 1 to bypass JWT auth and read the user from X-User-Slug header.
# NEVER enable in production.
AUTH_DISABLED=0

# ------------------------------------------------------------
# LLM backend
# ------------------------------------------------------------

# Which LLM backend to use for persona agents and judges.
# "ollama" uses a local Ollama instance; "openai" uses the OpenAI API.
LLM_BACKEND=ollama

# --- Ollama (used when LLM_BACKEND=ollama) ---

# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Default model name served by Ollama.
OLLAMA_DEFAULT_MODEL=mistral

# --- OpenAI (used when LLM_BACKEND=openai or for profile extraction) ---

# OpenAI API key. Required for persona profile extraction and when
# LLM_BACKEND=openai.
OPENAI_API_KEY=sk-...

# OpenAI model used for agent inference (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# MCP client
# ------------------------------------------------------------

# Base URL of the Angry Agents REST API, used by the MCP client.
ANGRY_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------
# Development / CI
# ------------------------------------------------------------

# Set to 1 to turn deviation() warnings into hard exceptions.
# Always run tests with this enabled: STRICT_MODE=1 pytest
STRICT_MODE=0
