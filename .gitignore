# --- Secrets / environment ---
.env
.env.local
secrets.json

# --- MCP config (machine-specific paths, generated by setup_mcp.py) ---
.mcp.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.log
*.tmp
*.bak

# --- Virtual environments ---
.venv/
venv/
env/

# --- SQLite database (created at runtime by the API) ---
*.db
*.db-shm
*.db-wal

# --- Testing ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Project-specific ---
scripts/
angry-agents/src/agents/scraping/personas/

# --- ChromaDB vector store (rebuilt with build_index) ---
data/chroma/

# --- Evaluation outputs (per-chat judge records, metrics, token reports) ---
data/eval/chat_*/

# --- Temp test artifacts ---
cookies.txt

# --- OS ---
.DS_Store
Thumbs.db
*.lnk

# --- graphify (knowledge graph) ---
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json

# --- Linters / type checkers ---
.ruff_cache/
.mypy_cache/

# --- Python packaging ---
dist/
build/
*.egg-info/
*.egg

# --- IDE ---
.vscode/
.idea/
